NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/velament
CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000

# CLIENT_ORIGIN accepts comma-separated origins, without trailing slashes.
# Never place server credentials in VITE_ variables.

# GitHub App: configure server-side only. Private key can contain escaped newlines.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CALLBACK_URL=http://localhost:4000/api/github/callback
# Generate 32 random bytes as 64 hex characters; keep stable and secret.
TOKEN_ENCRYPTION_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# Login providers (separate from repository GitHub App authorization).
# Register /api/auth/google/callback and /api/auth/github/callback on this API origin.
# Both origins must be HTTPS in production; deploy frontend/API on the same site.
AUTH_API_ORIGIN=http://localhost:4000
AUTH_APP_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional source-grounded feature discovery (explicit source-sharing request).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
